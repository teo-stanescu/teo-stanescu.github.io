{
  "name": "mission-log-site",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint . && node scripts/check-no-cv-text.mjs src/components src/entry-server.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit --passWithNoTests",
    "test:dist": "vitest run tests/dist --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "verify:ci": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:dist && npm run test:e2e",
    "hooks:install": "git config core.hooksPath .githooks",
    "check:private": "node scripts/check-private.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "todos": "node scripts/report-todos.mjs",
    "test:local": "vitest run tests/local --passWithNoTests",
    "verify": "npm run verify:ci && npm run test:local && npm run check:private"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
